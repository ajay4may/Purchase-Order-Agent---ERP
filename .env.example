# Foundry project and model deployment. The hosted runtime injects the project endpoint.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=<structured-output-capable-model-deployment>

# Azure AI Document Intelligence resource endpoint. Grant the hosted agent identity
# Cognitive Services User on this resource.
DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/

# Optional operational settings.
MAX_FILE_SIZE_BYTES=26214400
ARITHMETIC_ABSOLUTE_TOLERANCE=0.02
ARITHMETIC_RELATIVE_TOLERANCE=0.005
LOG_LEVEL=INFO

# Auto-injected by Foundry when Application Insights is connected.
# APPLICATIONINSIGHTS_CONNECTION_STRING=

